# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: comma-separated Gemini models to try in order
# GEMINI_MODEL=gemini-2.5-flash,gemini-3.5-flash

# Frontend URL(s) allowed by CORS, comma-separated, no trailing slash.
# localhost is always allowed for development.
FRONTEND_URL=https://your-frontend.vercel.app

# Optional: also allow any https://*.vercel.app preview URL
ALLOW_VERCEL_PREVIEWS=false

PORT=5000
