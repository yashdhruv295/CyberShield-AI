# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend URL (no trailing slash). Local: http://localhost:5000
VITE_API_URL=http://localhost:5000

# Max file size uploaded to the backend. Keep 4 on Vercel (4.5 MB body limit).
VITE_MAX_UPLOAD_MB=4
